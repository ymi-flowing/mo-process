# Local dev sample. Copy to a real .env (or paste into Cardentials.txt).
# Env vars WIN over Cardentials.txt in every loader — use env for CI/GH
# Actions, Cardentials.txt for the local dev fallback.

# ResMan web login (Playwright).
RESMAN_USER=SNS_Assistant
RESMAN_PASS=<changeme>

# ResMan Partner API (multipart POST /Documents).
RESMAN_PARTNER_ID=SNSaPi
RESMAN_API_KEY=<changeme>
RESMAN_ACCOUNT_ID=1550

# Docupost sendletter API + dashboard scrape (cert screenshot).
DOCUPOST_TOKEN=<changeme>
DOCUPOST_WEB_USER=assistant@snsmgmt.com
DOCUPOST_WEB_PASS=<changeme>

# GitHub Contents API push (Docupost fetches the PDF from raw.githubusercontent.com).
# GH Actions auto-provides GITHUB_TOKEN — no need to set it there.
# Locally, the loader falls back to `gh auth token` when both env and
# Cardentials.txt are absent.
GITHUB_TOKEN=<optional-pat-with-repo-scope>
